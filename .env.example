# leaf configuration. Precedence: CLI flags > environment > this file > defaults.
# Copy to .env; every line is optional.

# Bind address and port (0 = pick a free port)
#HOST=127.0.0.1
# Default 4321 so the browser's sticky settings survive relaunches; falls back to a free port if busy.
#PORT=4321

# error | warn (default: quiet unless something is wrong) | info (routine traffic) | debug (payloads)
#LOG_LEVEL=warn

# text (human, colored in a terminal) | json (one object per line)
#LOG_FORMAT=text

# PlantUML server base URL. Unset = plantuml blocks show their source.
# Local: `docker compose up -d` starts one on 8180. Public: https://www.plantuml.com/plantuml
#PLANTUML_URL=http://localhost:8180

# Open the browser on start
#LEAF_OPEN=true

# gitignore-style patterns always skipped, comma separated
#LEAF_IGNORE=.git,node_modules,.DS_Store

# Honor .gitignore files under the root
#LEAF_GITIGNORE=true

# Cap for expand-all and search results
#LEAF_MAX_ENTRIES=5000

# Files larger than this (bytes) are not sent inline over the socket
#LEAF_MAX_INLINE_BYTES=2097152

# Link templates for @user and #topic, e.g. https://x.com/{username}
#LEAF_MENTION_URL=
#LEAF_TOPIC_URL=

# Where preferences.json lives. Default: $XDG_CONFIG_HOME/leaf or ~/.config/leaf
#LEAF_CONFIG_DIR=

# Stop a `leaf open --browser` server this long after its last tab disconnects. `leaf serve`: never (0).
#LEAF_IDLE_TIMEOUT=10s
