#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  echo "usage: bin/install [--uninstall]    build leaf, symlink this checkout's \`leaf\` into your user bin dir,"
  echo "  and (macOS) install ~/Applications/leaf reader.app for leaf:// links (see bin/bundle)"
  echo "  LEAF_BIN_DIR overrides the target; otherwise the first of ~/.local/bin, ~/bin that is on PATH."
}
pick_bin_dir() {
  if [[ -n "${LEAF_BIN_DIR:-}" ]]; then echo "$LEAF_BIN_DIR"; return; fi
  for d in "$HOME/.local/bin" "$HOME/bin"; do
    case ":$PATH:" in *":$d:"*) echo "$d"; return ;; esac
  done
  echo "bin/install: neither ~/.local/bin nor ~/bin is on your PATH; set LEAF_BIN_DIR=<dir on PATH>" >&2
  exit 1
}
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --uninstall)
    d="$(pick_bin_dir)"
    rm -f "$d/leaf" && echo "removed $d/leaf"
    bin/bundle --remove
    exit 0 ;;
  "") ;;
  *) usage >&2; exit 1 ;;
esac

LEAF_BUNDLE=1 bin/build
d="$(pick_bin_dir)"
mkdir -p "$d"
ln -sfn "$(pwd)/target/release/leaf" "$d/leaf"
echo "installed: $d/leaf -> $(pwd)/target/release/leaf (a live link; rebuild with bin/build)"
# macOS: bin/build made the app that leaf:// links open in (~/Applications/leaf reader.app).
