#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  echo "usage: bin/bundle [--remove]    (macOS) build ~/Applications/leaf reader.app around target/release/leaf"
  echo "  and register it for leaf:// links; --remove unregisters and deletes it. LEAF_APP overrides the path."
}
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  ""|--remove) ;;
  *) usage >&2; exit 1 ;;
esac
[[ "$(uname)" == "Darwin" ]] || { echo "bin/bundle: macOS only; elsewhere leaf links go through \`leaf leaf://…\`" >&2; exit 0; }

app="${LEAF_APP:-$HOME/Applications/leaf reader.app}"
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

if [[ "${1:-}" == "--remove" ]]; then
  [[ -d "$app" ]] || { echo "no app at $app"; exit 0; }
  "$lsregister" -u "$app" || true
  rm -rf "$app"
  echo "removed $app"
  exit 0
fi

[[ -x target/release/leaf ]] || { echo "bin/bundle: build first (bin/build)" >&2; exit 1; }
version="$(target/release/leaf --version)"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
# A copy, not a link: macOS knows a running app by where its binary lives.
cp target/release/leaf "$app/Contents/MacOS/leaf"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>leaf reader</string>
  <key>CFBundleDisplayName</key><string>leaf reader</string>
  <key>CFBundleIdentifier</key><string>dev.leaf.reader</string>
  <key>CFBundleExecutable</key><string>leaf</string>
  <key>CFBundleIconFile</key><string>leaf</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${version}</string>
  <key>CFBundleVersion</key><string>${version}</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>leaf document link</string>
      <key>CFBundleURLSchemes</key><array><string>leaf</string></array>
    </dict>
  </array>
</dict>
</plist>
PLIST
if [[ ! -f "$app/Contents/Resources/leaf.icns" ]]; then
  set_dir="$(mktemp -d)/leaf.iconset"
  mkdir -p "$set_dir"
  for s in 16 32 128 256 512; do
    sips -z $s $s crates/leaf-app/icons/icon.png --out "$set_dir/icon_${s}x${s}.png" >/dev/null
    d=$((s * 2)); [[ $d -le 512 ]] && sips -z $d $d crates/leaf-app/icons/icon.png --out "$set_dir/icon_${s}x${s}@2x.png" >/dev/null
  done
  iconutil -c icns "$set_dir" -o "$app/Contents/Resources/leaf.icns" || echo "bin/bundle: no icon (iconutil failed)" >&2
fi
codesign --force --sign - "$app" >/dev/null 2>&1 || echo "bin/bundle: could not sign $app" >&2
"$lsregister" -f "$app"
echo "bundled $app (leaf:// links open here)"
