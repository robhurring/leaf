{
  "$ref": "#/definitions/preferences",
  "definitions": {
    "preferences": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "preferences"
        },
        "preferences": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "github",
                "glass",
                "card",
                "paper"
              ]
            },
            "appearance": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "auto"
              ]
            },
            "treeOpen": {
              "type": "boolean"
            },
            "outlineOpen": {
              "type": "boolean"
            },
            "numbering": {
              "type": "boolean"
            },
            "textPct": {
              "type": "integer",
              "minimum": 50,
              "maximum": 200
            },
            "treeWidth": {
              "type": "integer",
              "minimum": 160,
              "maximum": 480
            },
            "outlineWidth": {
              "type": "integer",
              "minimum": 160,
              "maximum": 480
            },
            "linkSchemes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]*$"
              }
            }
          },
          "additionalProperties": false
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "preferences"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
