{
  "$ref": "#/definitions/welcome",
  "definitions": {
    "welcome": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "protocol": {
          "type": "number",
          "const": 1
        },
        "root": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "file",
                "dir"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "plantumlUrl": {
              "type": "string"
            },
            "mentionUrl": {
              "type": "string"
            },
            "topicUrl": {
              "type": "string"
            },
            "maxEntries": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "watch": {
              "type": "boolean"
            },
            "write": {
              "type": "boolean"
            },
            "collaborate": {
              "type": "boolean"
            },
            "rawUrls": {
              "type": "boolean"
            }
          },
          "required": [
            "watch",
            "write",
            "collaborate"
          ],
          "additionalProperties": false
        },
        "participant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "color": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "preferences": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "github",
                "glass",
                "card",
                "paper"
              ]
            },
            "appearance": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "auto"
              ]
            },
            "treeOpen": {
              "type": "boolean"
            },
            "outlineOpen": {
              "type": "boolean"
            },
            "numbering": {
              "type": "boolean"
            },
            "textPct": {
              "type": "integer",
              "minimum": 50,
              "maximum": 200
            },
            "treeWidth": {
              "type": "integer",
              "minimum": 160,
              "maximum": 480
            },
            "outlineWidth": {
              "type": "integer",
              "minimum": 160,
              "maximum": 480
            },
            "linkSchemes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]*$"
              }
            },
            "openIn": {
              "type": "string",
              "enum": [
                "tab",
                "window"
              ]
            },
            "reopenTabs": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "id": {
          "type": "string"
        },
        "inReplyTo": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol",
        "root",
        "config",
        "capabilities",
        "participant"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
